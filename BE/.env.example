PORT=3000

# MongoDB connection string. For Atlas, include the database name in the path -
# without it mongoose silently uses the default "test" database.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.ukmocw3.mongodb.net/mytools?retryWrites=true&w=majority&appName=Cluster0

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Changing this invalidates every stored PIN blind index, which locks every
# existing account out of PIN login. Set it once and keep it.
PIN_INDEX_SECRET=

# Token lifetime, e.g. 15m, 1h, 7d
JWT_EXPIRES_IN=1h

# Google Gemini. Server-side only - never expose this to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated origins allowed to call this API from a browser. Leave empty
# in development; set it to the deployed frontend URL in production, e.g.
#   ALLOWED_ORIGINS=https://my-tools.pages.dev
ALLOWED_ORIGINS=

# Set this on the hosted app and sign-up needs it. Leave empty locally and
# sign-up stays open. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
SIGNUP_CODE=
